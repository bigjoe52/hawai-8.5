# Postgres connection string (Vercel gives you this automatically when you
# add a Neon/Postgres store to the project -- you should not need to set it by hand)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# Your Sleeper league ID. Find it in the URL when you open your league on
# sleeper.com: https://sleeper.com/leagues/<THIS_NUMBER>/team
SLEEPER_LEAGUE_ID=""

# Optional: point the Sleeper client somewhere else. Leave unset in normal use;
# these exist so the app can be run against a stand-in during development.
# SLEEPER_API_BASE="https://api.sleeper.app/v1"
# SLEEPER_PROJECTIONS_BASE="https://api.sleeper.com"

# The league's own week schedule. Week 1 runs until 3am Eastern on the date
# below, then the week ticks over every Tuesday at 3am Eastern.
# Change these at the start of a new season rather than editing the code.
# LEAGUE_SEASON=2026
# LEAGUE_WEEK2_DATE=2026-09-15

# Live odds for parlay legs, from Polymarket's public API. No account or key
# needed. POLYMARKET_TAG only needs changing if Polymarket reorganises its
# categories and "nfl" stops matching.
# POLYMARKET_TAG=nfl
# POLYMARKET_API_BASE=https://gamma-api.polymarket.com

# Whoever places week 1's parlay, by username. From week 2 on it is whoever
# scored lowest the week before, worked out from Sleeper.
# LEAGUE_FIRST_PLACER=biz
